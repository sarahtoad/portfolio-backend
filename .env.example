# ------------------------------------------------------------------
# Portfolio backend (Express + Postgres)
# Copy this file to `.env` and fill in real values.
# ------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development

# Comma separated list of allowed frontend origins (CORS + credentials).
# In production use the deployed frontend URL, e.g. https://portfolio.vercel.app
CORS_ORIGIN=http://localhost:3000

# Public base URL of THIS backend. Used to build absolute upload URLs.
PUBLIC_URL=http://localhost:4000

# Postgres connection string.
# Neon / Vercel Postgres example (use the *pooled* connection string):
#   postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio

# Set to "false" only when connecting to a local Postgres without TLS.
DATABASE_SSL=true

# Admin auth — change these! ADMIN_SECRET must be 16+ random characters.
ADMIN_PASSWORD=change-me
ADMIN_SECRET=change-me-too

# Cross-site cookie attribute. Leave "auto" for sensible defaults:
#   production  -> SameSite=None; Secure (required for cross-site fetch)
#   development -> SameSite=Lax
# Override with: none | lax | strict
COOKIE_SAMESITE=auto

# Max upload size in megabytes.
MAX_UPLOAD_MB=8
